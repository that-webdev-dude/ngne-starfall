{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM"],
        "types": [],
        "strict": true,
        "skipLibCheck": false,
        "noEmit": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true
    },
    "include": ["src", "vite.config.ts"]
}
