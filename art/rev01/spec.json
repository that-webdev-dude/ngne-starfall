{
  "version": "rev01",
  "conventions": {
    "units": "pixels in the 640x360 logical view; 1 texel = 1 logical pixel, no runtime scaling",
    "origin": "top-left of each canvas, +x right, +y down",
    "pivot": "canvas pixel the game position maps to; sockets are offsets from the pivot, +y down",
    "canvas": "odd width and odd height, so a symmetric ship has a 1 px centre column and the pivot sits on a whole pixel (also after the engine's -90 degree rotation of the Kiln parts); backgrounds are exempt",
    "alpha": "binary: palette index 0 is transparent, every other pixel fully opaque",
    "frames": "one full palette-index grid per frame (baked frames), stored as a horizontal strip PNG, frames left to right in 'order'"
  },
  "viewport": {
    "logical": [640, 360],
    "previous": [480, 270],
    "worldScaleFromPrevious": 1.3333333333333333,
    "presentation": "integer scale k = floor(min(screenW / 640, screenH / 360)) in device pixels, k >= 1; the remainder is letterbox/pillarbox in the clear colour",
    "integerScales": {
      "1280x720": 2, "1280x800 (Steam Deck)": 2, "1920x1080": 3, "1920x1200": 3,
      "2560x1440": 4, "3440x1440": 4, "3840x2160": 6
    },
    "optionalTallMode": { "logical": [640, 400], "use": "16:10 screens only; the extra 40 rows hold background and HUD, never playfield" }
  },
  "palette": {
    "note": "One shared indexed palette. Ramps are contiguous and ordered dark -> light. Index 0 is transparent.",
    "ramps": [
      { "name": "outline", "first": 1, "colors": ["#0b0f1c", "#1a1d2a"] },
      { "name": "steel", "first": 3, "colors": ["#3a3d4a", "#62656e", "#9a9ca0", "#d6d9d4"] },
      { "name": "hero", "first": 7, "colors": ["#1f3b56", "#2f6a8c", "#5fa6c4", "#b9e6f0"] },
      { "name": "cockpit", "first": 11, "colors": ["#c46a1f", "#ffb14a"] },
      { "name": "exhaust", "first": 13, "colors": ["#0b2fd0", "#1892fb", "#6fd6fc", "#f0fdff"] },
      { "name": "raider", "first": 17, "colors": ["#3a0f17", "#7a1c22", "#b0302a", "#e86048"] },
      { "name": "brass", "first": 21, "colors": ["#5c4224", "#8f6a48", "#c99a5b"] },
      { "name": "violet", "first": 24, "colors": ["#2b1b3d", "#4e2b5f", "#7f4f96"] },
      { "name": "navy", "first": 27, "colors": ["#1f2a44", "#34476a", "#5a7099"] },
      { "name": "rust", "first": 30, "colors": ["#3a1d14", "#723219", "#b2552a", "#e08a45"] },
      { "name": "olive", "first": 34, "colors": ["#2a3833", "#4f5f50", "#8a8b66"] },
      { "name": "engine", "first": 37, "colors": ["#3e2148", "#6a4777", "#9c7aa8"] },
      { "name": "glow", "first": 40, "colors": ["#6b1050", "#d02a8f", "#ff8fd8"] },
      { "name": "bone", "first": 43, "colors": ["#8a6e5c", "#d6c0a2"] },
      { "name": "fire", "first": 45, "colors": ["#6b1a05", "#dd3701", "#f58a0c", "#fbd23a", "#fff6d0"] },
      { "name": "pickup", "first": 50, "colors": ["#174d47", "#56dba4", "#b3ffd5"] },
      { "name": "ui", "first": 53, "colors": ["#8aabbf", "#ffd39c", "#dde9e3"] }
    ],
    "size": 56,
    "backgrounds": "each stage background has its own palette of at most 32 colours; it must not use the fire, glow, pickup or cockpit ramps, and its lightest value stays below the steel ramp's lightest"
  },
  "sprites": [
    { "id": "player", "replaces": "player-bank.png", "canvas": [31, 33], "pivot": [15, 16], "maxColors": 16,
      "ramps": ["outline", "steel", "hero", "cockpit"],
      "frames": ["bank-left", "neutral", "bank-right"],
      "animation": { "type": "input-pose", "transitionMs": 65 },
      "sockets": { "exhaust": { "bank-left": [[-3, 15], [4, 15]], "neutral": [[-4, 15], [4, 15]], "bank-right": [[-4, 15], [3, 15]] } } },
    { "id": "exhaust", "replaces": "exhaust.png", "canvas": [7, 15], "pivot": [3, 0], "maxColors": 5,
      "ramps": ["exhaust"],
      "frames": ["short", "medium", "long"],
      "animation": { "type": "loop", "order": ["short", "medium", "long", "medium"], "durationsMs": [80, 80, 80, 80] } },
    { "id": "interceptor", "replaces": "interceptor.png", "canvas": [27, 23], "pivot": [13, 11], "maxColors": 12,
      "ramps": ["outline", "steel", "raider"], "frames": ["interceptor"] },
    { "id": "dart", "usedBy": "Sweeper", "replaces": "dart.png", "canvas": [13, 25], "pivot": [6, 12], "maxColors": 10,
      "ramps": ["outline", "steel", "raider"], "frames": ["dart"],
      "sockets": { "muzzle": [0, 12] } },
    { "id": "gunship", "replaces": "gunship.png", "canvas": [39, 31], "pivot": [19, 15], "maxColors": 14,
      "ramps": ["outline", "steel", "brass", "violet"], "frames": ["gunship"],
      "sockets": { "leftMuzzle": [-15, 15], "rightMuzzle": [15, 15], "reactor": [0, -3] } },
    { "id": "warden", "replaces": "warden.png", "canvas": [33, 31], "pivot": [16, 15], "maxColors": 14,
      "ramps": ["outline", "violet", "raider", "brass"], "frames": ["warden"],
      "sockets": { "leftMuzzle": [-8, 10], "rightMuzzle": [8, 10] } },
    { "id": "minelayer", "replaces": "minelayer.png", "canvas": [29, 29], "pivot": [14, 14], "maxColors": 12,
      "ramps": ["outline", "olive", "brass", "steel"], "frames": ["minelayer"],
      "sockets": { "mineRelease": [0, 10] } },
    { "id": "gatebreaker", "replaces": "gatebreaker.png", "canvas": [159, 79], "pivot": [79, 39], "maxColors": 24,
      "ramps": ["outline", "steel", "navy", "raider", "brass", "fire"], "frames": ["gatebreaker"],
      "sockets": { "core": [0, 1], "leftTurret": [-47, 4], "rightTurret": [47, 4], "leftMuzzles": [[-50, 32], [-44, 32]], "rightMuzzles": [[44, 32], [50, 32]] } },
    { "id": "kilnHead", "replaces": "kiln-head.png", "canvas": [65, 47], "pivot": [32, 23], "maxColors": 20,
      "ramps": ["outline", "steel", "rust", "fire"], "frames": ["kilnHead"],
      "orientation": "same as today's source; the engine rotates it by exactly -90 degrees",
      "sockets": { "core": [0, 0], "rearCoupling": [0, -23], "drill": [0, 21], "leftCutter": [-22, 13], "rightCutter": [22, 13] } },
    { "id": "kilnSegment", "replaces": "kiln-segment.png", "canvas": [41, 23], "pivot": [20, 11], "maxColors": 14,
      "ramps": ["outline", "steel", "rust"], "frames": ["kilnSegment"],
      "orientation": "same as kilnHead",
      "sockets": { "core": [0, 0], "frontCoupling": [0, 11], "rearCoupling": [0, -11] } },
    { "id": "starfallEngine", "replaces": "starfall-engine.png", "canvas": [143, 111], "pivot": [71, 48], "maxColors": 24,
      "ramps": ["outline", "engine", "glow", "bone", "steel"], "frames": ["starfallEngine"],
      "sockets": { "leftEmitter": [-41, -1], "rightEmitter": [41, -1], "core": [0, 0], "lowerEmitter": [0, 30] } },
    { "id": "explosion", "replaces": "explosion.png", "canvas": [31, 31], "pivot": [15, 15], "maxColors": 6,
      "ramps": ["fire", "outline"],
      "frames": ["explosion-0", "explosion-1", "explosion-2", "explosion-3", "explosion-4", "explosion-5"],
      "animation": { "type": "once", "durationsMs": [45, 50, 65, 65, 65, 75] } },
    { "id": "breakwaterBackground", "replaces": "orbital-breakwater.png", "canvas": [640, 400], "pivot": [320, 200], "maxColors": 32,
      "ramps": ["own stage palette"], "frames": ["breakwater"] },
    { "id": "furnaceBackground", "replaces": "furnace-background.png", "canvas": [640, 400], "pivot": [320, 200], "maxColors": 32,
      "ramps": ["own stage palette"], "frames": ["furnace"] },
    { "id": "citadelBackground", "replaces": "citadel-background.png", "canvas": [640, 400], "pivot": [320, 200], "maxColors": 32,
      "ramps": ["own stage palette"], "frames": ["citadel"] }
  ],
  "codeDrawn": {
    "note": "Drawn with frame.rect today and already crisp; keep them in code and only change the sizes.",
    "hostileBullet": { "ring": 9, "fill": 7, "highlight": 3, "ringColor": "#351a39", "highlightColor": "#ffeddf" },
    "playerShot": { "width": 3, "height": 11, "color": "#ffe0a4" },
    "pickup": { "outer": 15, "inner": 13, "cross": [9, 3] },
    "mine": { "diamond": 13, "core": 7, "centre": 3 },
    "playerCore": { "outer": 7, "inner": 3 }
  },
  "gameplay": {
    "note": "Proposals. All world constants scale by 4/3 so timing and screen-relative speeds stay as they are; collision radii follow the new sprite sizes.",
    "playerRadius": 5,
    "hostileBulletRadius": 4,
    "enemyRadius": {
      "Interceptor": 9, "Gunship": 13, "Sweeper": 8, "Gatebreaker": 42, "GatebreakerTurret": 15,
      "Minelayer": 11, "Warden": 12, "Mine": 7, "KilnHead": 21, "KilnSegment": 14,
      "StarfallEngine": 38, "EngineEmitter": 13
    },
    "bossWeakpointScale": { "gatebreaker": 1.445, "starfallEngine": 1.375 }
  }
}
